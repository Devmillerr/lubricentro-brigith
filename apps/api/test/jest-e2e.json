{
  "preset": "ts-jest/presets/default-esm",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "useESM": true, "tsconfig": { "module": "esnext" } }],
    "[\\\\/]@nestjs[\\\\/]throttler[\\\\/]dist[\\\\/].+\\.js$": "<rootDir>/support/nestjs-esm-bridge.cjs"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(\\.pnpm/@nestjs\\+throttler@[^/]+/node_modules/)?@nestjs/throttler/)"
  ],
  "setupFiles": ["<rootDir>/support/e2e-database-guard.ts"],
  "setupFilesAfterEnv": ["<rootDir>/support/nestjs-esm-bridge.setup.ts"],
  "testEnvironment": "node",
  "testTimeout": 20000
}
