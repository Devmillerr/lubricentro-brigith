{
  "preset": "ts-jest/presets/default-esm",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "useESM": true, "tsconfig": { "module": "esnext" } }]
  },
  "testEnvironment": "node"
}
