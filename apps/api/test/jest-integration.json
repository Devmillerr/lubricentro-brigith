{
  "preset": "ts-jest/presets/default-esm",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test/integration"],
  "testRegex": ".*.int-spec.ts$",
  "transform": {
    "^.+.tsx?$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "esnext"
        }
      }
    ]
  },
  "testEnvironment": "node",
  "testTimeout": 60000
}
