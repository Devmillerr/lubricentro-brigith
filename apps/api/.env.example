# Postgres. En desarrollo local instala PostgreSQL 16 y crea la base "brigith".
# Con Supabase: DATABASE_URL es el pooler de transacciones (puerto 6543), para
# la app en runtime. Si el password tiene caracteres reservados de URL (@ : / ?
# # [ ] etc.), hay que codificarlos (@ -> %40).
DATABASE_URL="postgresql://brigith:brigith@localhost:5432/brigith?schema=public"

# Solo con Supabase, y solo para Prisma Migrate (prisma.config.ts): el pooler
# de transacciones no soporta prepared statements ni advisory locks. Si la
# conexión directa (db.<ref>.supabase.co:5432) no resuelve por DNS (requiere
# IPv6), usar el "session pooler": mismo host que DATABASE_URL, puerto 5432.
# DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:5432/postgres"

PORT=4000

# Orígenes permitidos para CORS (coma-separado). En desarrollo, la web local.
CORS_ORIGIN="http://localhost:3000"

# Secretos de JWT: generar valores propios, p. ej.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET=replace-with-a-random-secret
JWT_REFRESH_TTL="30d"

# Rate limit (DEC-86). "memory" sirve con una sola instancia de la API;
# "database" comparte los contadores en Postgres entre instancias (Vercel).
# Si se omite: "database" con NODE_ENV=production y "memory" en el resto.
# RATE_LIMIT_STORE=memory

# Saltos de proxy de confianza para la IP del cliente (Express "trust proxy").
# 0 = conexión directa, sin proxy. Detrás del proxy de Vercel: 1.
TRUST_PROXY=0

# Solo para `prisma:seed`. La contraseña del dueño nunca vive en el repositorio.
SEED_OWNER_PASSWORD=replace-with-a-development-password
