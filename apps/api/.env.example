# Postgres. En desarrollo local instala PostgreSQL 16 y crea la base "brigith".
DATABASE_URL="postgresql://brigith:brigith@localhost:5432/brigith?schema=public"

PORT=4000

# Orígenes permitidos para CORS (coma-separado). En desarrollo, la web local.
CORS_ORIGIN="http://localhost:3000"

# Secretos de JWT. Generar valores propios; nunca usar estos en producción.
JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET=replace-with-a-random-secret
JWT_REFRESH_TTL="30d"

# Solo para `prisma:seed`. La contraseña del dueño nunca vive en el repositorio.
SEED_OWNER_PASSWORD=replace-with-a-development-password
