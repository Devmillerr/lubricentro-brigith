// Brigith — esquema de base de datos
// C0: negocio, usuarios, sesión e idempotencia. C1: clientes y vehículos.
// El resto de tablas de dominio (Product, Maintenance, ...) se agregan en los
// cortes siguientes, ver /docs/05-DATABASE.md.

generator client {
  provider = "prisma-client-js"
}

// La URL de conexión ya no va aquí (Prisma 7): ver `prisma.config.ts`.
datasource db {
  provider = "postgresql"
}

/// Regla de vencimiento cuando un mantenimiento tiene km y fecha (DEC-01).
enum DueRule {
  KM
  DATE
  ANY
  ALL
}

/// Política ante stock insuficiente al usar un producto (DEC-05).
enum InsufficientStockPolicy {
  ALLOW_WITH_WARNING
  BLOCK
}

/// Único rol del MVP. Agregar otro es un nuevo valor, no un cambio de estructura (P-12).
enum UserRole {
  OWNER
}

/// Un negocio (tenant). Brigith es el primero; "demo" existe para pruebas (BR-G7).
model Business {
  id   String @id @default(uuid())
  name String
  slug String @unique

  timezone           String  @default("America/Lima")
  currency           String? // A confirmar en el seed.
  defaultCountryCode String? // Para el enlace de WhatsApp (BR-W5). A confirmar tras P-01.

  /// Nulo hasta decidir (BR-R5, DEC-03).
  reminderLeadDays        Int?
  /// Nulo hasta decidir (BR-M5, DEC-01).
  defaultDueRuleWhenBoth  DueRule?
  /// Provisional: ALLOW_WITH_WARNING (BR-P11, BR-P12, DEC-05).
  insufficientStockPolicy InsufficientStockPolicy @default(ALLOW_WITH_WARNING)
  /// Nulo hasta P-13 (BR-W4).
  whatsappTemplate        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  refreshTokens          RefreshToken[]
  idempotencyRecords     IdempotencyRecord[]
  customers              Customer[]
  vehicleModels          VehicleModel[]
  vehicles               Vehicle[]
  productCategories      ProductCategory[]
  products               Product[]
  productCompatibilities ProductCompatibility[]
  inventoryMovements     InventoryMovement[]
  inventoryReceipts      InventoryReceipt[]
  sales                  Sale[]
  saleLines              SaleLine[]
  washTypes              WashType[]
  washPriceOptions       WashPriceOption[]
  maintenanceTypes       MaintenanceType[]
  maintenances           Maintenance[]
  reminders              Reminder[]

  @@map("businesses")
}

/// Usuario del negocio. En el MVP, un usuario pertenece a un solo negocio (BR-G2).
/// `username` es único **globalmente**, no por negocio (DEC-25): el login es
/// `{ username, password }` sin que el cliente indique el negocio, y el
/// `businessId` se resuelve buscando este usuario. Es la única excepción a
/// "las unicidades son por negocio" (04-ARCHITECTURE.md §5, 05-DATABASE.md §1).
model User {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  name             String
  username         String   @unique
  passwordHash     String
  /// Hash (argon2) del código de recuperación de un solo uso. Se genera al
  /// cambiar la contraseña y se rota al recuperarla; null = todavía sin código.
  recoveryCodeHash String?
  role             UserRole @default(OWNER)
  isActive         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens            RefreshToken[]
  createdCustomers         Customer[]
  createdVehicleModels     VehicleModel[]
  createdVehicles          Vehicle[]
  confirmedCompatibilities ProductCompatibility[]
  voidedMaintenances       Maintenance[]
  reminderContacts         ReminderContact[]
  inventoryMovements       InventoryMovement[]
  inventoryReceipts        InventoryReceipt[]
  createdSales             Sale[]                 @relation("SaleCreatedBy")
  voidedSales              Sale[]                 @relation("SaleVoidedBy")

  @@map("users")
}

/// Token de refresco, con rotación. Se guarda con hash, nunca en texto plano.
model RefreshToken {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  /// Si se rotó, apunta al token que lo reemplazó (para detectar reuso).
  replacedByTokenHash String?

  createdAt DateTime @default(now())

  @@index([businessId, userId])
  @@map("refresh_tokens")
}

/// Registro de idempotencia para escrituras críticas (mantenimientos, inventario).
/// Ver 04-ARCHITECTURE.md §7.3 y 05-DATABASE.md §3 (IdempotencyRecord).
/// Único por (businessId, key, endpoint): la misma clave puede reusarse en
/// endpoints distintos sin chocar entre sí (antes solo era businessId+key,
/// lo que hacía fallar la segunda escritura con un 500 en vez de un
/// resultado correcto — auditoría, hallazgo A-2).
/// `responseStatus`/`responseBody` nulos mientras el handler todavía está
/// corriendo: la fila se inserta ANTES de ejecutar el handler, para que el
/// unique constraint sea quien de verdad impide que dos peticiones
/// concurrentes con la misma clave ejecuten el efecto dos veces (hallazgo
/// A-1). Se completan al terminar; si el handler falla, la fila se borra.
model IdempotencyRecord {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  key            String
  endpoint       String
  requestHash    String
  responseStatus Int?
  responseBody   Json?

  createdAt DateTime @default(now())

  @@unique([businessId, key, endpoint])
  @@map("idempotency_records")
}

/// Cliente del negocio. Ningún campo es obligatorio salvo el id (BR-C3).
model Customer {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  name  String?
  phone String?
  notes String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
  /// Siempre vacío en R4: la venta de mostrador no pide cliente (DEC-44).
  sales    Sale[]

  @@index([businessId, phone])
  @@map("customers")
}

/// Marca y modelo de vehículo. Año y motor opcionales: el nivel de detalle de
/// la compatibilidad de filtros se define con datos, no con estructura (BR-F6).
model VehicleModel {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  /// Opcional desde R2: los textos del dueño ("Kia 2016", "Yaris moderno") se
  /// guardan tal cual en `model`, sin inventar una marca (BR-F6, DEC-07).
  make       String?
  model      String
  yearFrom   Int?
  yearTo     Int?
  engineNote String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles        Vehicle[]
  compatibilities ProductCompatibility[]

  @@map("vehicle_models")
}

/// Vehículo. Siempre tiene placa; cliente y modelo son opcionales (BR-C4, BR-C5).
model Vehicle {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  /// Como el usuario la escribió.
  plate           String
  /// Mayúsculas, sin espacios ni guiones: para buscar y comparar. Única por
  /// negocio (BR-C6).
  plateNormalized String

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  vehicleModelId String?
  vehicleModel   VehicleModel? @relation(fields: [vehicleModelId], references: [id])

  year  Int?
  color String?
  notes String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // El "último km conocido" se calcula desde el mantenimiento activo más
  // reciente con km (05-DATABASE.md); no se guarda aquí.

  maintenances Maintenance[]
  reminders    Reminder[]
  /// Solo el cobro de un mantenimiento (R6) llena `Sale.vehicleId`.
  sales        Sale[]

  @@unique([businessId, plateNormalized])
  @@map("vehicles")
}

/// Categoría de producto. Semilla: Lubricante y Filtro (BR-P18) y el árbol de
/// DEC-37 debajo de ellas. Sin
/// `createdById`: no está en el campo documentado (05-DATABASE.md §3).
model ProductCategory {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  name String

  /// Máximo 2 niveles (categoría → subcategoría), validado en el servicio. Es
  /// un dato editable desde Configuración, no una taxonomía fija (BR-P18, R2).
  parentId String?
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([businessId, name])
  @@map("product_categories")
}

/// Cada fila es una unidad de stock en la que se cuenta y descuenta (BR-P15).
/// Cómo se representan presentaciones y granel queda para DEC-22; con esta
/// estructura, ambas opciones son solo datos (05-DATABASE.md §3): `unit` es
/// texto libre a propósito, para no cerrar ninguna opción.
model Product {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  /// Texto libre. Marcas confirmadas: Repsol, Vistony, Valvoline (C-10).
  brand String?
  /// Único por negocio si existe; los filtros se manejan por código (C-05).
  code  String?
  name  String

  /// Unidad en la que se cuenta y descuenta (BR-P15). Vocabulario pendiente
  /// de DEC-22/P-07: hoy es texto libre para no cerrar ninguna opción.
  unit String

  /// Opcional; ningún precio se asume (BR-P17). Se usa recién en la Fase 2.
  salePrice Decimal? @db.Decimal(10, 2)

  /// Por defecto controla stock (BR-P16); puede marcarse sin control.
  tracksStock Boolean @default(true)

  /// Saldo en caché (R1, 10-OPERACION-REAL.md §2.1). Solo lo escribe el
  /// StockLedger, en la misma transacción que inserta el movimiento y con la
  /// fila bloqueada. Fuente de verdad: la suma de `quantityDelta` de sus
  /// movimientos (BR-P3); la invariante se prueba contra Postgres real.
  stockQuantity Decimal @default(0) @db.Decimal(12, 3)
  /// Tiene al menos un COUNT (BR-P8). También en caché, escrito por el StockLedger.
  isCounted     Boolean @default(false)

  /// Opcionales (R2, BR-P19b): se eligen de sugerencias (`GET /products/facets`),
  /// nunca se inventan ni se exigen.
  viscosity    String?
  presentation String?
  /// Opcional. Sin subida todavía (DEC-34): la UI muestra un placeholder.
  imageKey     String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compatibilities    ProductCompatibility[]
  inventoryMovements InventoryMovement[]
  maintenanceItems   MaintenanceItem[]
  saleLines          SaleLine[]

  @@unique([businessId, code])
  @@index([businessId, categoryId, isActive])
  @@map("products")
}

/// Compatibilidad explícita producto <-> modelo de vehículo (BR-F1, BR-F3).
/// Nunca la crea un mantenimiento ni una venta (BR-F2): solo esta acción.
model ProductCompatibility {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])

  confirmedById String
  confirmedBy   User     @relation(fields: [confirmedById], references: [id])
  confirmedAt   DateTime @default(now())

  note String?

  @@unique([productId, vehicleModelId])
  @@map("product_compatibilities")
}

/// Tipos de movimiento con punto de entrada en el MVP: COUNT, PURCHASE_IN,
/// MAINTENANCE_USE, MAINTENANCE_VOID, ADJUSTMENT (BR-P4). SALE y SALE_VOID
/// ya están en el modelo (BR-P14) pero su punto de entrada depende de
/// DEC-24: ningún endpoint los crea todavía.
enum InventoryMovementType {
  COUNT
  PURCHASE_IN
  MAINTENANCE_USE
  MAINTENANCE_VOID
  ADJUSTMENT
  SALE
  SALE_VOID
}

/// Todo cambio de stock es un movimiento; el saldo de un producto es la
/// suma de sus `quantityDelta` (BR-P2, BR-P3). Solo se insertan filas:
/// nunca se editan ni se borran (BR-G5). Solo los inserta el StockLedger
/// (src/inventory/stock-ledger.ts), que además mantiene `Product.stockQuantity`.
model InventoryMovement {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  type InventoryMovementType

  /// Con signo: entra +, sale − (BR-P3). Decimal para no cerrar ninguna
  /// opción de unidad/presentación (BR-P15).
  quantityDelta Decimal @db.Decimal(12, 3)

  /// Solo en COUNT: la cantidad contada (BR-P7).
  countedQuantity Decimal? @db.Decimal(12, 3)
  /// Solo en COUNT: saldo calculado justo antes, para auditar la diferencia.
  previousBalance Decimal? @db.Decimal(12, 3)

  /// Obligatorio en ADJUSTMENT (BR-P10).
  reason String?

  /// Origen del movimiento (por ejemplo, el mantenimiento que lo generó).
  refType String?
  refId   String?

  /// Saldo del producto justo después de este movimiento, calculado con la
  /// fila del producto bloqueada. Nulo en los movimientos anteriores a R1.
  resultingBalance Decimal? @db.Decimal(12, 3)

  /// Quién lo registró. Nulo en los movimientos anteriores a R1.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  occurredAt DateTime @default(now())

  @@index([businessId, productId, occurredAt])
  @@map("inventory_movements")
}

/// Cabecera de una recepción de mercadería en lote (R3, BR-P6). Sus líneas
/// son `InventoryMovement` de tipo `PURCHASE_IN` con
/// `refType = 'InventoryReceipt'` y `refId = id`, igual que un mantenimiento
/// enlaza sus movimientos (sin FK: `refType`/`refId` es polimórfico). Solo se
/// insertan; no se editan ni se borran (BR-G5). Sin proveedor ni costo de
/// compra (DEC-36).
model InventoryReceipt {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  /// Cuándo llegó la mercadería; puede ser anterior al registro.
  occurredAt DateTime @default(now())
  note       String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, occurredAt])
  @@map("inventory_receipts")
}

// ---------------------------------------------------------------------------
// Ventas (R4, 06-API.md §2 "Ventas", 10-OPERACION-REAL.md §2.3). Todo ingreso
// es una `Sale` (BR-V5). En R4 solo existe la venta de mostrador
// (`COUNTER`, líneas `PRODUCT`); lavado (R5) y cobro de mantenimiento (R6)
// usan los mismos modelos más adelante.
// ---------------------------------------------------------------------------

/// Un solo método por venta (DEC-30, BR-V6). Pago mixto: decisión futura.
enum PaymentMethod {
  CASH
  YAPE
}

enum SaleSource {
  COUNTER
  WASH
  MAINTENANCE
}

enum SaleStatus {
  ACTIVE
  VOIDED
}

enum SaleLineKind {
  PRODUCT
  WASH
  SERVICE
}

model Sale {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  source        SaleSource
  status        SaleStatus    @default(ACTIVE)
  paymentMethod PaymentMethod
  /// Suma de los subtotales de las líneas, calculada en el servidor (el
  /// cliente no la envía).
  total         Decimal       @db.Decimal(10, 2)
  /// Cuándo se vendió; puede ser anterior al registro.
  occurredAt    DateTime      @default(now())
  note          String?

  /// Fuera de R4 (siempre nulos): existen para que el contrato no cambie en
  /// R5/R6. `vehicleId` solo lo llena el cobro de un mantenimiento (R6).
  vehicleId     String?
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id])
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  /// 1:1 con el mantenimiento cobrado (R6).
  maintenanceId String?      @unique
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id])

  createdById String
  createdBy   User   @relation("SaleCreatedBy", fields: [createdById], references: [id])

  /// Al anular (BR-V7): el motivo es obligatorio.
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines SaleLine[]

  @@index([businessId, occurredAt])
  @@index([businessId, status, occurredAt])
  @@map("sales")
}

/// Línea de una venta, con `businessId` propio porque el dashboard (R7)
/// agrega por línea. No mueve stock por sí misma: el movimiento `SALE` lo crea
/// el StockLedger, enlazado a la venta por `refType = 'Sale'`/`refId` (BR-V5).
model SaleLine {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  kind SaleLineKind

  /// Obligatorio en las líneas `PRODUCT` (las únicas de R4).
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  /// Obligatorio en las líneas `WASH` (R5, DEC-53). Siempre nulo en R4.
  washTypeId String?
  washType   WashType? @relation(fields: [washTypeId], references: [id])

  /// Snapshots al momento de la venta (BR-G6, BR-V8): cambiar el catálogo no
  /// altera ventas pasadas.
  descriptionSnapshot String
  codeSnapshot        String?

  /// En la unidad del producto (sin formas de venta en R4).
  quantity   Decimal @db.Decimal(12, 3)
  /// Precio aplicado en esta venta (DEC-29).
  unitPrice  Decimal @db.Decimal(10, 2)
  /// quantity × unitPrice, redondeado half-up a 2 decimales.
  subtotal   Decimal @db.Decimal(10, 2)
  /// `false` si el producto no controla stock (`tracksStock = false`, BR-V4).
  movesStock Boolean

  @@index([businessId, saleId])
  @@index([businessId, productId])
  @@map("sale_lines")
}

// ---------------------------------------------------------------------------
// Lavados (R5, 06-API.md §2 "Lavados", DEC-53 a DEC-68). No hay tabla de
// lavado: un lavado es una `Sale` `WASH` con una `SaleLine` `WASH`. Estos dos
// modelos son solo la configuración de tipos y precios.
// ---------------------------------------------------------------------------

/// Tipo de lavado (moto lineal, auto, camioneta...). Sin borrado físico
/// (DEC-17): se desactiva con `isActive`.
model WashType {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  /// Único por negocio (DEC-65: `WASH_TYPE_ALREADY_EXISTS`).
  name      String
  /// Opcional. Sin subida (DEC-34), igual que `Product.imageKey`.
  imageKey  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceOptions WashPriceOption[]
  saleLines    SaleLine[]

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
  @@map("wash_types")
}

/// Opción de precio de un tipo de lavado. El cobro siempre sale de una opción
/// activa, sin monto libre (DEC-55). Sin borrado físico (DEC-63).
model WashPriceOption {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  washTypeId String
  washType   WashType @relation(fields: [washTypeId], references: [id])

  amount    Decimal @db.Decimal(10, 2)
  /// Nulo: el dueño elige el monto al ver el vehículo, sin criterio escrito
  /// (10-OPERACION-REAL.md §0.3).
  label     String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, washTypeId, sortOrder])
  @@map("wash_price_options")
}

enum MaintenanceStatus {
  ACTIVE
  VOIDED
}

/// Tipo de mantenimiento. Semilla: "Cambio de aceite" (BR-M13). Otros tipos
/// no se crean por defecto.
model MaintenanceType {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenances Maintenance[]
  reminders    Reminder[]

  @@unique([businessId, name])
  @@map("maintenance_types")
}

/// Guardarlo es una sola transacción indivisible: crea el mantenimiento,
/// sus productos, sus movimientos de inventario y su recordatorio, o no
/// crea nada (BR-M10, 04-ARCHITECTURE.md §7.1). Sin `createdById`: no está
/// en el campo documentado (05-DATABASE.md §3), a diferencia de
/// `voidedById` que sí lo está.
model Maintenance {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  /// Opcional desde R6 (DEC-31, DEC-73). Sin vehículo no admite km ni
  /// próximo km/fecha/regla y no genera recordatorio (BR-M16). `onDelete:
  /// Restrict` explícito: con la relación opcional, Prisma usaría `SetNull`
  /// y cambiaría la FK existente.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  maintenanceTypeId String
  maintenanceType   MaintenanceType @relation(fields: [maintenanceTypeId], references: [id])

  /// Cuándo se hizo; puede ser anterior al registro (BR-M9).
  performedAt DateTime
  odometerKm  Int?

  /// Ninguno, uno o ambos; sin próximo km ni fecha es válido y no genera
  /// recordatorio (BR-M2, BR-M6).
  nextDueKm   Int?
  nextDueDate DateTime?
  /// KM/DATE se infieren; ANY/ALL los elige el usuario cuando hay ambos,
  /// sin valor por defecto salvo que el negocio configure uno (BR-M4, BR-M5).
  dueRule     DueRule?

  notes String?

  status MaintenanceStatus @default(ACTIVE)

  /// Al anular (BR-M12).
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation(fields: [voidedById], references: [id])
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     MaintenanceItem[]
  reminders Reminder[]
  /// Cobro del mantenimiento (R6), 1:1. Siempre nulo en R4.
  sale      Sale?

  @@index([businessId, vehicleId, performedAt])
  @@map("maintenances")
}

/// Producto usado en un mantenimiento, cantidad > 0 (BR-M8). Sin
/// `businessId` propio: siempre se llega a través de `Maintenance`, que sí
/// está aislado por negocio (05-DATABASE.md §3). Nombre y código se copian
/// al registrar: renombrar el catálogo no altera el pasado (BR-G6).
model MaintenanceItem {
  id            String      @id @default(uuid())
  maintenanceId String
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id])
  productId     String
  product       Product     @relation(fields: [productId], references: [id])

  productNameSnapshot String
  productCodeSnapshot String?
  quantity            Decimal @db.Decimal(12, 3)

  @@map("maintenance_items")
}

enum ReminderStatus {
  PENDING
  CONTACTED
  DONE
  DISMISSED
}

/// Como máximo un recordatorio abierto (PENDING/CONTACTED) por
/// (businessId, vehicleId, maintenanceTypeId) — único parcial agregado a
/// mano en la migración, Prisma no expresa índices únicos parciales
/// (05-DATABASE.md §5, BR-R2). "Corresponde avisar ahora" se calcula en la
/// consulta (C5); esta tabla no lo guarda.
model Reminder {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  maintenanceTypeId String
  maintenanceType   MaintenanceType @relation(fields: [maintenanceTypeId], references: [id])

  sourceMaintenanceId String
  sourceMaintenance   Maintenance @relation(fields: [sourceMaintenanceId], references: [id])

  /// Copiados del mantenimiento que lo originó.
  dueDate DateTime?
  dueKm   Int?
  dueRule DueRule

  status ReminderStatus @default(PENDING)

  /// Al cerrarlo: cumplido (otro mantenimiento del mismo tipo, BR-R2),
  /// descartado (BR-R9) o el mantenimiento que lo originó fue anulado
  /// (BR-M12). Referencia suave, igual que `InventoryMovement.refId`.
  closedByMaintenanceId String?
  closedAt              DateTime?
  closeReason           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts ReminderContact[]

  @@map("reminders")
}

enum ReminderContactChannel {
  WHATSAPP_LINK
}

/// Historial de avisos abiertos (BR-W6). No prueba que se haya enviado, solo
/// que se abrió el enlace (BR-W2). Sin `businessId` propio: siempre se
/// llega a través de `Reminder`, que sí está aislado por negocio.
model ReminderContact {
  id         String   @id @default(uuid())
  reminderId String
  reminder   Reminder @relation(fields: [reminderId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  channel         ReminderContactChannel @default(WHATSAPP_LINK)
  openedAt        DateTime               @default(now())
  /// Texto tal como se generó al abrir el enlace (BR-W3, BR-W4).
  messageSnapshot String

  @@map("reminder_contacts")
}
